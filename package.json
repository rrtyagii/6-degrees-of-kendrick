{
  "name": "6-deg-of-kendrick",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "css": "tailwindcss -i ./src/styles/styles.css -o ./src/styles/output.css",
    "dev": "npm run build && node scripts/dev.cjs",
    "build": "node scripts/clean-build.cjs && npm run css && tsc",
    "start": "node build/server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "npm run type-check && npm run build && node --test build/test/*.test.js"
  },
  "type": "commonjs",
  "dependencies": {
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
