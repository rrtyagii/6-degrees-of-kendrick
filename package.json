{
  "name": "6-deg-of-kendrick",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "css": "tailwindcss -i ./src/styles/styles.css -o ./src/styles/output.css",
    "dev": "npm run build && node scripts/dev.cjs",
    "build": "node scripts/clean-build.cjs && npm run css && tsc",
    "start": "node build/server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "npm run type-check && npm run build && node --test build/test/*.test.js"
  },
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
