{
  "compilerOptions": {
    "target": "es2022",
    "module": "CommonJS",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "./build",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "sourceMap": true
  },
  "include": [
    "server.ts",
    "tailwind.config.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "build"]
}
